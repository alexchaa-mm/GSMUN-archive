# Copy to .env.local. Use your Supabase project's URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used ONLY by the one-time migration script. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Leave unset to use Supabase when configured; use local only for explicit seed previews/tests.
# GSMUN_CONTENT_SOURCE=local
