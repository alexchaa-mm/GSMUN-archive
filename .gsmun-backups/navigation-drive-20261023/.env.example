# Copy to .env.local. Use your Supabase project's URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy importer only (disabled). Not required by the app or reviewed release import.
# Leave empty; never prefix a privileged credential with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Leave unset to use Supabase when configured; use local only for explicit seed previews/tests.
# GSMUN_CONTENT_SOURCE=local

# Server-only object storage switch. Existing objects retain their own provider.
# Do not enable R2 billing or change production settings without approval.
GSMUN_OBJECT_STORAGE=supabase
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# proxy: authorization on EVERY image request; streams private bytes via Node.
# signed (optional): offloads bytes but issued bearer URLs live up to 30 seconds.
GSMUN_R2_DELIVERY=proxy
GSMUN_STORAGE_LIMIT_GB=35
# Optional private disk cache for display variants only, NEVER a public folder.
# GSMUN_MEDIA_CACHE_DIR=/var/cache/gsmun
GSMUN_MEDIA_CACHE_GB=8
# Exact production HTTPS origin behind the trusted reverse proxy. No trailing path.
# GSMUN_PUBLIC_ORIGIN=https://your-archive-hostname.example
