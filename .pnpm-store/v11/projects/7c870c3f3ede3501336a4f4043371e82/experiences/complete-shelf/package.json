{
  "name": "@mint/playground-experience-complete-shelf",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5203",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "node scripts/verify-offline.mjs",
    "verify:offline": "node scripts/verify-offline.mjs",
    "preview:sandbox": "node --require ./scripts/offline-guard.cjs scripts/preview-sandbox.mjs",
    "preview:public": "node scripts/preview-public.mjs",
    "content:check-import": "node scripts/check-import.mjs",
    "content:migrate": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/migrate-content.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/s3-request-presigner": "3.1155.0",
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/newsreader": "5.2.8",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "google-auth-library": "11.3.1",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "^0.35.5",
    "three": "0.185.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "22.19.15",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3"
  }
}
