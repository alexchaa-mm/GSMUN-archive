# Copy to .env.local. Use your Supabase project's URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server SDK request deadline (Auth/metadata and legacy Supabase Storage).
GSMUN_DATABASE_TIMEOUT_MS=60000
# Legacy importer only (disabled). Not required by the app or reviewed release import.
# Leave empty; never prefix a privileged credential with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Leave unset to use Supabase when configured; use local only for explicit seed previews/tests.
# GSMUN_CONTENT_SOURCE=local

# Server-only object storage switch. Existing objects retain their own provider.
# Do not enable R2 billing or change production settings without approval.
GSMUN_OBJECT_STORAGE=supabase
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Must match the actual bucket jurisdiction; do not change existing storage
# account/bucket/jurisdiction without a reviewed storage migration.
R2_JURISDICTION=default
GSMUN_STORAGE_TIMEOUT_MS=60000
# proxy: authorization on EVERY image request; streams private bytes via Node.
# signed (optional): offloads bytes but issued bearer URLs live up to 30 seconds.
GSMUN_R2_DELIVERY=proxy
GSMUN_STORAGE_LIMIT_GB=35
# Optional private disk cache for display variants only, NEVER a public folder.
# GSMUN_MEDIA_CACHE_DIR=/var/cache/gsmun
GSMUN_MEDIA_CACHE_GB=8
# Exact production HTTPS origin behind the trusted reverse proxy. No trailing path.
# Also used for public share metadata: supply at build AND runtime.
# GSMUN_PUBLIC_ORIGIN=https://your-archive-hostname.example

# Optional Drive → configured private object storage → draft photos only.
# Disabled by default. No credentials in this repo or NEXT_PUBLIC_ variables.
# Review docs/DRIVE-IMPORT-SETUP.md and the proposed NEW tables before enabling.
GSMUN_DRIVE_ENABLED=0
GSMUN_DRIVE_ROOT_FOLDER_ID=
# Absolute private server path, outside the source/deployment/public directories.
GSMUN_DRIVE_KEY_FILE=
GSMUN_DRIVE_DAILY_GB=25
# Optional unattended polling: private persistent writable session file +
# read-only random secret file. Authorize explicitly using existing admin login.
GSMUN_DRIVE_WORKER_SESSION_FILE=
GSMUN_DRIVE_WORKER_SECRET_FILE=
