**/.local
**/.git
**/.env*
**/dist
**/.next
**/.agents
**/.codex
**/.aws
**/*.log
**/*.pem
**/*credentials*
**/*service-account*.json
**/*worker-secret*.txt
**/*worker-session*.json
**/*integration-approval*.json
**/supabase/.temp
**/secrets
.gsmun-backups
